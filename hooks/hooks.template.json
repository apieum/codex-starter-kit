{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/project-profile-startup.py",
            "timeout": 5,
            "statusMessage": "Checking project profile"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/handoff-permission-request.py",
            "timeout": 5,
            "statusMessage": "Checking handoff permission policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/handoff-intake-classifier.py",
            "timeout": 7,
            "statusMessage": "Classifying handoff intent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$|^shell$|^unified_exec$|^exec_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/block-dangerous-shell.py",
            "timeout": 5,
            "statusMessage": "Checking shell command safety"
          },
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/tdd-harness.py",
            "timeout": 120,
            "statusMessage": "Checking project harness"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^shell$|^unified_exec$|^exec_command$|^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/tdd-harness.py",
            "timeout": 120,
            "statusMessage": "Verifying project harness"
          },
          {
            "type": "command",
            "command": "python3 ${HOME}/.codex/hooks/handoff-post-tool-use.py",
            "timeout": 5,
            "statusMessage": "Reviewing shell result"
          }
        ]
      }
    ]
  }
}
