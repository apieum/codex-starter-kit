prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Permanent deletion with rm is blocked. Use: ls -ld <path> && gio trash <path> && test ! -e <path>.",
    match = ["rm -rf /", "rm -rf node_modules", "rm important.txt"],
)

prefix_rule(
    pattern = ["printf"],
    decision = "allow",
    justification = "printf is approved for autonomous handoff workflows. Safety hooks still inspect shell control operators and destructive follow-up commands.",
    match = ["printf '%s\\n' ok"],
)

prefix_rule(
    pattern = ["claude", "-p"],
    decision = "forbidden",
    justification = "Direct Claude print-mode commands are blocked. Use the Claude Companion plugin command path (`$claude:<mode> ...`) so Codex controls the review pack, tmux bridge, and outbox triage.",
    match = ["claude -p \"review this\""],
)

prefix_rule(
    pattern = ["claude", "--print"],
    decision = "forbidden",
    justification = "Direct Claude print-mode commands are blocked. Use the Claude Companion plugin command path (`$claude:<mode> ...`) so Codex controls the review pack, tmux bridge, and outbox triage.",
    match = ["claude --print \"review this\""],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is blocked by default. Ask the user for an explicit one-off elevated command if truly needed.",
    match = ["sudo apt install curl", "sudo rm -rf /"],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Raw disk writes can destroy data. Use a safer file-level tool or ask the user for an exact approved disk command.",
    match = ["dd if=/dev/zero of=/dev/sda"],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Formatting filesystems is blocked. This must be performed manually by the user.",
    match = ["mkfs /dev/sda1"],
)

prefix_rule(
    pattern = ["shred"],
    decision = "forbidden",
    justification = "Secure deletion is blocked. Use gio trash for recoverable deletion, or ask for explicit permanent deletion.",
    match = ["shred -u secrets.txt"],
)

prefix_rule(
    pattern = ["reboot"],
    decision = "forbidden",
    justification = "System reboot is blocked. The user must reboot the host manually.",
    match = ["reboot"],
)

prefix_rule(
    pattern = ["shutdown"],
    decision = "forbidden",
    justification = "System shutdown is blocked. The user must shut down the host manually.",
    match = ["shutdown now"],
)

prefix_rule(
    pattern = ["chmod"],
    decision = "prompt",
    justification = "Permission changes can expose or break files. Ask for the exact target and least-privilege mode.",
    match = ["chmod -R 777 .", "chmod 600 .env"],
)

prefix_rule(
    pattern = ["chown"],
    decision = "prompt",
    justification = "Ownership changes can break workspace or host permissions. Ask for the exact target and owner.",
    match = ["chown -R ubuntu:ubuntu ."],
)

prefix_rule(
    pattern = ["wipefs"],
    decision = "forbidden",
    justification = "Filesystem signature wiping is blocked. This must be performed manually by the user.",
    match = ["wipefs -a /dev/sda"],
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "prompt",
    justification = "Docker prune can delete containers, images, networks, and cache. Inspect usage first and ask for exact cleanup approval.",
    match = ["docker system prune -af"],
)
